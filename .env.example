# .env.example — settings for running the app on your computer.
#
# Copy this file to .env.local (git ignores it) and fill in the address.
# `npx expo start` reads it. EAS builds don't use this file: they read the
# EAS environment variable of the same name (see eas.json).
#
# The YaarSplit sync server, no trailing slash. Your Render URL, or
# http://<your computer's LAN IP>:3000 for a server running locally.
EXPO_PUBLIC_API_URL=https://your-app.onrender.com
