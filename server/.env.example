# Copy this file to ".env" (which git ignores) and fill in real values.
# NEVER commit the real .env — it holds your database password.

# From MongoDB Atlas: Database → Connect → Drivers. Replace <password>, and
# put the database name ("yaarsplit") after the ".net/".
MONGODB_URI=mongodb+srv://yaarsplit-app:<password>@cluster0.xxxxx.mongodb.net/yaarsplit?retryWrites=true&w=majority

# Port for local runs. Render sets its own, so don't add PORT there.
PORT=3000
